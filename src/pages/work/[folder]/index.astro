---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { url } from '../../../site';
import { getFolders, getProjects, projectsIn, type Folder, type Project } from '../../../lib/content';

export async function getStaticPaths() {
  const folders = await getFolders();
  const projects = await getProjects();
  return folders.map((folder, index) => ({
    params: { folder: folder.id },
    props: { folder, index, items: projectsIn(folder, projects) },
  }));
}

interface Props { folder: Folder; index: number; items: Project[] }
const { folder, index, items } = Astro.props;
const f = folder.data;
const tags = [...new Set(items.flatMap((p) => p.data.tags))].sort();
const num = String(index + 1).padStart(2, '0');
---
<Base title={f.title} description={f.intro ?? f.summary} current="work">
  <section class="band" style={`background:${f.color}`}>
    <div class="wrap" style="padding-block:56px 64px">
      <nav aria-label="Breadcrumb" class="mono" style="font-size:13px;font-weight:600;margin-bottom:28px">
        <a href={url('/')} style="text-decoration:none">HOME</a> / FOLDER {num}
      </nav>
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap">
        <div style="flex:999 1 520px;min-width:0">
          <h1 class="h-display" style="font-size:clamp(40px,7vw,64px);line-height:1;margin-bottom:20px">{f.title}</h1>
          <p style="margin:0;font-size:18px;max-width:560px;color:#2B2B2B">{f.intro ?? f.summary}</p>
        </div>
        <div class="mono" style="background:var(--paper);border:var(--line);box-shadow:var(--shadow);padding:18px 24px">
          <div style="font-size:44px;font-weight:700;line-height:1">{items.length}</div>
          <div style="font-size:13px;font-weight:600">PROJECT{items.length === 1 ? '' : 'S'} IN FOLDER</div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap" style="padding-block:48px 96px">
      {items.length === 0 ? (
        <p class="mono" style="font-weight:600">NEW WORK COMING SOON.</p>
      ) : (
        <>
          {tags.length > 1 && (
            <div class="filters" role="group" aria-label="Filter projects by tag" data-filters>
              <button type="button" aria-pressed="true" data-tag="">ALL</button>
              {tags.map((t) => <button type="button" aria-pressed="false" data-tag={t}>{t.toUpperCase()}</button>)}
            </div>
          )}
          <div class="grid-cards" data-grid>
            {items.map((p) => <ProjectCard project={p} folder={folder} />)}
          </div>
        </>
      )}
    </div>
  </section>

  <div class="wrap" style="padding-bottom:32px">
    <a href={url('/#folders')} class="mono" style="font-weight:700;text-decoration:none">← ALL FOLDERS</a>
  </div>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] > [data-tags]');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-tag]');
    if (!btn) return;
    const tag = btn.dataset.tag ?? '';
    bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    cards.forEach((c) => {
      const has = !tag || (c.dataset.tags ?? '').split('|').includes(tag);
      c.hidden = !has;
    });
  });
</script>
