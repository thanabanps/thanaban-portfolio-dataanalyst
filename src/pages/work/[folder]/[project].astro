---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { url } from '../../../site';
import { getFolders, getProjects, projectsIn, folderOf, type Folder, type Project } from '../../../lib/content';

export async function getStaticPaths() {
  const folders = await getFolders();
  const projects = await getProjects();
  return projects.map((project) => {
    const folder = folderOf(project, folders);
    const siblings = projectsIn(folder, projects);
    const i = siblings.findIndex((p) => p.id === project.id);
    const next = siblings.length > 1 ? siblings[(i + 1) % siblings.length] : undefined;
    const index = folders.findIndex((f) => f.id === folder.id);
    return { params: { folder: folder.id, project: project.id }, props: { project, folder, next, index } };
  });
}

interface Props { project: Project; folder: Folder; next?: Project; index: number }
const { project, folder, next, index } = Astro.props;
const p = project.data;
const f = folder.data;
const { Content } = await render(project);
const facts = [
  ['ROLE', p.role],
  ['STACK', p.stack.join(' · ')],
  ['BUILT WITH', p.builtWith],
  ['TIMELINE', p.timeline],
].filter(([, v]) => v);
const num = String(index + 1).padStart(2, '0');
const link = (x: string) => (/^https?:\/\//.test(x) ? x : url(x));
/** Cover first, then gallery — shown together as one slider. */
const slides = [
  ...(p.cover ? [{ src: p.cover, caption: p.coverCaption ?? `${p.title} — main view` }] : []),
  ...p.gallery,
];
---
<Base title={p.title} description={p.summary} current="work">
  <section class="band">
    <div class="wrap narrow" style="padding-block:56px 64px">
      <nav aria-label="Breadcrumb" class="mono" style="font-size:13px;font-weight:600;margin-bottom:28px">
        <a href={url('/')} style="text-decoration:none">HOME</a>{' / '}
        <a href={url(`/work/${folder.id}/`)} style="text-decoration:none">{f.title.toUpperCase()}</a>{' / CASE STUDY'}
      </nav>
      <span class="tag" style={`background:${f.color};font-size:12px;padding:3px 10px;display:inline-block;margin-bottom:20px`}>
        FOLDER {num} · {p.type}
      </span>
      <h1 class="h-display" style="margin-bottom:22px">{p.title}</h1>
      <p class="lead" style="margin:0 0 36px;font-size:20px;max-width:720px">{p.summary}</p>
      {facts.length > 0 && (
        <dl class="facts" style="margin:0">
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      )}
      {p.demo && (
        <div style="margin-top:32px">
          <a href={link(p.demo)} class="btn btn-yellow lift" target="_blank" rel="noopener">TRY LIVE DEMO →</a>
        </div>
      )}
    </div>
  </section>

  {slides.length > 0 && (
    <section class="band" style={`background:${f.color}`}>
      <div class="wrap" style="padding-block:56px">
        <div class="carousel" data-carousel>
          <div class="car-track" data-track tabindex="0" role="region" aria-roledescription="carousel" aria-label={`${p.title} screenshots`}>
            {slides.map((s, i) => (
              <figure class="car-slide" aria-label={`${i + 1} of ${slides.length}: ${s.caption}`}>
                <button type="button" class="car-zoom" data-zoom={url(s.src)} aria-label={`Enlarge: ${s.caption}`}>
                  <img src={url(s.src)} alt={s.caption} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </button>
              </figure>
            ))}
          </div>
          {slides.length > 1 && (
            <>
              <button type="button" class="car-nav car-prev" data-prev aria-label="Previous screenshot">←</button>
              <button type="button" class="car-nav car-next" data-next aria-label="Next screenshot">→</button>
            </>
          )}
        </div>
        <div class="car-meta">
          <p class="car-caption" data-caption aria-live="polite">{slides[0].caption}</p>
          {slides.length > 1 && <span class="car-count mono" data-count>1 / {slides.length}</span>}
        </div>
        {slides.length > 1 && (
          <div class="car-thumbs" role="group" aria-label="Choose a screenshot">
            {slides.map((s, i) => (
              <button type="button" data-go={i} aria-label={`Show: ${s.caption}`} aria-current={i === 0 ? 'true' : 'false'}>
                <img src={url(s.src)} alt="" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {p.stats.length > 0 && (
    <section class="band">
      <div class="wrap narrow" style="padding-block:72px">
        <div class="stats">
          {p.stats.map((s) => <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>)}
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap narrow prose" style="padding-block:72px">
      <Content />
    </div>
  </section>

  {(p.demo || p.repo) && (
    <section class="band" style="background:var(--paper)">
      <div class="wrap" style="padding-block:56px">
        {(p.demo || p.repo) && (
          <div style="display:flex;gap:16px;flex-wrap:wrap">
            {p.demo && <a href={link(p.demo)} class="btn btn-yellow lift" target="_blank" rel="noopener">TRY LIVE DEMO →</a>}
            {p.sample && <a href={link(p.sample)} class="btn lift" download>DOWNLOAD SAMPLE EXCEL</a>}
            {p.repo && <a href={p.repo} class="btn lift">VIEW ON GITHUB</a>}
          </div>
        )}
        {p.sample && <p class="muted" style="margin:16px 0 0;font-size:14px">Open the demo, then drop the sample Excel file into it to generate a dashboard.</p>}
        {p.demo && <p class="muted" style="margin:8px 0 0;font-size:14px">Demo runs on simulated data. Names and numbers do not reflect any real company.</p>}
      </div>
    </section>
  )}

  <nav class="wrap mono" aria-label="More projects" style="padding-block:40px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-weight:700">
    <a href={url(`/work/${folder.id}/`)} style="text-decoration:none">← ALL {f.title.toUpperCase()}</a>
    {next && <a href={url(`/work/${folder.id}/${next.id}/`)} style="text-decoration:none">NEXT: {next.data.title.toUpperCase()} →</a>}
  </nav>

  <dialog class="lightbox" data-lightbox>
    <form method="dialog"><button class="btn btn-sm" aria-label="Close">✕</button></form>
    <img alt="" />
  </dialog>
</Base>

<script>
  // Screenshot slider: scroll-snap track + arrows, thumbnails, keyboard and swipe.
  const track = document.querySelector<HTMLElement>('[data-track]');
  if (track) {
    const slides = [...track.children] as HTMLElement[];
    const caption = document.querySelector<HTMLElement>('[data-caption]');
    const count = document.querySelector<HTMLElement>('[data-count]');
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const prev = document.querySelector<HTMLButtonElement>('[data-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-next]');
    let current = 0;
    const go = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: n * track.clientWidth, behavior: 'smooth' });
    };
    const sync = () => {
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      if (i === current && caption?.textContent) return;
      current = i;
      const img = slides[i]?.querySelector('img');
      if (caption && img) caption.textContent = img.alt;
      if (count) count.textContent = `${i + 1} / ${slides.length}`;
      thumbs.forEach((t, k) => t.setAttribute('aria-current', String(k === i)));
      thumbs[i]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); });
    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.go))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
    });
    window.addEventListener('resize', () => track.scrollTo({ left: current * track.clientWidth }));
    current = -1; sync();
  }

  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = dlg?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => {
    b.addEventListener('click', () => {
      if (!dlg || !img) return;
      img.src = b.dataset.zoom ?? '';
      img.alt = b.querySelector('img')?.alt ?? '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
