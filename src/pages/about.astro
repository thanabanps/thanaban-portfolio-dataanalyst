---
import Base from '../layouts/Base.astro';
import { SITE, url } from '../site';

const experience = [
  {
    title: 'Admin Sales — Modern Trade',
    org: 'R&B Food Supply PCL · Bangkok',
    period: '2024 – Present',
    points: [
      'Built dashboards and daily / monthly sales reports used by the sales team and management',
      'Turned raw SAP ERP exports into clean, decoded datasets that every report is built on',
      'Designed and built internal tools and automations with AI to replace manual spreadsheet work',
      'Analysed promotion campaign performance with the sales team',
      'Coordinated with warehouse, logistics and factory teams during peak seasons and promotions',
    ],
  },
  {
    title: 'Electrical Technician Intern',
    org: 'Internship Program',
    period: '2015 – 2017',
    points: ['Installed electrical systems from blueprints and technical drawings'],
  },
];
const education = [
  { title: 'Computer Engineering — coursework', org: "King Mongkut's University of Technology North Bangkok (KMUTNB)" },
  { title: 'Vocational Certificate — Electrical', org: 'Minburi Technical College' },
];
const skills = [
  { group: 'Data & BI', items: ['Excel', 'SQL', 'SAP ERP', 'Looker Studio', 'Google Sheets'] },
  { group: 'Code', items: ['Python', 'JavaScript', 'TypeScript', 'HTML', 'CSS'] },
  { group: 'AI', items: ['Claude', 'Prompting', 'AI-assisted development'] },
  { group: 'Ways of working', items: ['Problem-solving', 'Fast learner', 'Cross-team coordination'] },
];
---
<Base title="About" description={`About ${SITE.name} — experience, education and skills.`} current="about">
  <section class="band">
    <div class="wrap narrow" style="padding-block:72px 64px">
      <p class="kicker">/ ABOUT</p>
      <h1 class="h-display" style="margin-bottom:24px">From sales ops to builder.</h1>
      <p class="lead" style="margin:0 0 16px">
        I'm Thanaban ({SITE.nameThai}), based in {SITE.location}. I started in Modern Trade sales operations, and
        most of what I've built began because I saw a team stuck on slow, manual work.
      </p>
      <p class="lead" style="margin:0 0 32px">
        Today I work across data, AI, automation and web — and I'm open to roles where building things that save
        people time is the job.
      </p>
      <div style="display:flex;gap:16px;flex-wrap:wrap">
        {SITE.cv && <a href={url(SITE.cv)} class="btn btn-yellow lift" download>DOWNLOAD CV</a>}
        <a href={`mailto:${SITE.email}`} class="btn lift">EMAIL ME</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap narrow" style="padding-block:72px">
      <h2 class="h-section" style="margin-bottom:40px">Experience</h2>
      <div style="display:flex;flex-direction:column;gap:24px">
        {experience.map((e) => (
          <article style="background:var(--paper);border:var(--line);box-shadow:var(--shadow);padding:28px">
            <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap">
              <h3 class="h-card">{e.title}</h3>
              <span class="mono" style="font-weight:600;font-size:14px">{e.period}</span>
            </div>
            <p class="mono" style="margin:4px 0 14px;font-size:14px;color:var(--ink-soft)">{e.org}</p>
            <ul style="margin:0;padding-left:20px">
              {e.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap narrow" style="padding-block:72px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:48px">
      <div>
        <h2 class="h-section" style="margin-bottom:32px">Education</h2>
        {education.map((ed) => (
          <div style="border-left:4px solid var(--ink);padding-left:16px;margin-bottom:24px">
            <h3 class="h-card" style="font-size:17px">{ed.title}</h3>
            <p style="margin:4px 0 0" class="muted">{ed.org}{ed.note && ` · ${ed.note}`}</p>
          </div>
        ))}
      </div>
      <div>
        <h2 class="h-section" style="margin-bottom:32px">Skills</h2>
        {skills.map((s) => (
          <div style="margin-bottom:20px">
            <p class="mono" style="font-size:13px;font-weight:700;margin:0 0 10px">{s.group.toUpperCase()}</p>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px">
              {s.items.map((i) => <li class="chip">{i}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
