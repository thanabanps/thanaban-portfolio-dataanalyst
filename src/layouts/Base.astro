---
import '../styles/global.css';
import { SITE, url } from '../site';

interface Props { title?: string; description?: string; current?: 'work' | 'about' }
const { title, description = SITE.description, current } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#F4EFEA" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@400;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="topbar">{SITE.banner} — <a href={url('/#contact')}>LET'S TALK →</a></div>
  <header class="site-header">
    <div class="wrap">
      <a href={url('/')} class="logo">{SITE.short}<span>.P</span></a>
      <nav class="nav" aria-label="Main">
        <a href={url('/#folders')} aria-current={current === 'work' ? 'page' : undefined}>WORK</a>
        <a href={url('/about/')} aria-current={current === 'about' ? 'page' : undefined}>ABOUT</a>
        <a href={url('/#contact')}>CONTACT</a>
        {SITE.cv && <a href={url(SITE.cv)} class="btn btn-yellow btn-sm" download>DOWNLOAD CV</a>}
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} {SITE.name.toUpperCase()}</span>
      <span>BUILT WITH ASTRO</span>
    </div>
  </footer>
</body>
</html>
